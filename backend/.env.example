# Tryb modułów: fake (atrapa) albo real (implementacja produkcyjna).
MODULE_MODE_DEFAULT=fake
# MODULE_MODE_CASES=real
# MODULE_MODE_ARCHIVE=real

# Kotwica "dziś" dla danych demonstracyjnych. Puste = prawdziwa data.
DEMO_TODAY=2026-03-16

# Termin ustawowy odpowiedzi na wniosek (dni).
DEFAULT_RESPONSE_DAYS=14

# Tryb offline — blokuje wywołania zewnętrzne.
OFFLINE=false

# Warstwa modeli.
# fake     — atrapa, bez modelu (tryb demo)
# llamacpp — lokalny serwer llama.cpp (docelowy tryb urzędu, bez sieci)
# ollama   — lokalny Ollama
# mistral  — Mistral La Plateforme (chmura; dozwolone na hackathonie)
# openai   — dowolny serwer zgodny z OpenAI
LLM_PROVIDER=fake
LLM_MODEL=Bielik-11B-v2.3-Instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# Przykład: Mistral w chmurze na czas hackathonu.
#   LLM_PROVIDER=mistral
#   LLM_MODEL=mistral-small-latest
#   LLM_API_KEY=<klucz z console.mistral.ai>
# Ten sam model (Mistral Small 3.1 24B, Apache 2.0) uruchomisz lokalnie przez
# llama.cpp — zmienia się wtedy tylko LLM_PROVIDER i LLM_BASE_URL.

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=384

# Baza danych.
DATABASE_URL=sqlite:///./data/app.db

# Limit rozmiaru wgrywanego pliku (bajty).
MAX_UPLOAD_BYTES=10485760

# ── uwierzytelnianie ──
# Klucz do podpisywania tokenów sesji. Pusty = losowy przy każdym starcie,
# więc po restarcie wszyscy logują się ponownie. W demo wpisz stałą wartość.
AUTH_SECRET=
AUTH_SESSION_HOURS=8
# false wyłącza logowanie — demo i testy działają wtedy bez PIN-u,
# ale inicjały w sprawach nadal pochodzą z pierwszego użytkownika fixtures.
AUTH_ENABLED=true
