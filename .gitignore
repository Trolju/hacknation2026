# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
.vite/

# Dane lokalne
data/
*.db
*.sqlite3
# …ale zbiór held-out jest częścią testów, nie danymi lokalnymi.
!backend/app/modules/anonymize/tests/data/

# Skrypty uruchomieniowe
.run/

# Środowisko
.env
.env.local

# Edytory
.vscode/
.idea/
.DS_Store

# Nagrania i klipy — duże pliki binarne, trzymamy poza historią.
# Film jest artefaktem zgłoszenia, ale nie musi jechać w gicie: 100 MB
# w historii spowalnia klonowanie każdemu, kto chce tylko przejrzeć kod.
*.mp4
*.mov
*.webm

# Generator filmu (Revideo) — lokalne narzędzie, nie część zgłoszenia.
# 400 MB z node_modules; film buduje się z niego na żądanie.
video/

# Prezentacja — lokalne narzędzie i artefakty budowane przez build.py.
# Zostaje na dysku, ale nie w historii: zrzuty ekranu ważą więcej niż kod.
prezentacja/
