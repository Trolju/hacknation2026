# Konfiguracja wdrożenia dockerowego.
#
#   cp deploy/.env.example deploy/.env
#
# Plik `deploy/.env` jest w .gitignore i nie trafia do obrazu.
# Wszystkie wartości są opcjonalne — bez nich aplikacja wystartuje na atrapach.

# ── port interfejsu ───────────────────────────────────────────────────────
# Pod tym portem wystawiony jest nginx z aplikacją: http://localhost:8080
APP_PORT=8080

# ── tryb modułów ──────────────────────────────────────────────────────────
# fake = deterministyczne atrapy z fixtures/ (bez modeli, bez sieci)
# real = implementacje produkcyjne z backend/app/adapters/real/
MODULE_MODE_DEFAULT=fake

# Przełączanie pojedynczych modułów — nadpisuje MODULE_MODE_DEFAULT.
# Moduł bez adaptera realnego wraca do atrapy i loguje ostrzeżenie.
# MODULE_MODE_CASES=real
# MODULE_MODE_INGEST=real
# MODULE_MODE_ARCHIVE=real
# MODULE_MODE_ROUTING=real
# MODULE_MODE_DRAFTING=real
# MODULE_MODE_ANONYMIZE=real
# MODULE_MODE_INFERENCE=real
# MODULE_MODE_AUDIT=real

# ── tryb offline ──────────────────────────────────────────────────────────
# true = aplikacja nie wykonuje żadnych połączeń sieciowych.
OFFLINE=false

# ── terminy ───────────────────────────────────────────────────────────────
DEFAULT_RESPONSE_DAYS=14

# Kotwica "dziś" dla danych demonstracyjnych (ISO 8601).
# Usuń linię, aby użyć wartości domyślnej z backend/app/core/settings.py.
# Pusta wartość jest błędem walidacji — albo data, albo brak linii.
DEMO_TODAY=2026-03-16

# ── model językowy (tylko przy MODULE_MODE_INFERENCE=real) ────────────────
LLM_PROVIDER=fake
LLM_MODEL=Bielik-11B-v2.3-Instruct
# Z wnętrza kontenera host jest widoczny jako host.docker.internal.
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2

# ── embeddingi ────────────────────────────────────────────────────────────
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=384

# ── upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
